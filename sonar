sonar.projectKey=kamalakarjana_lbg
sonar.organization=kamalakarjana
sonar.projectName=lbg
sonar.projectVersion=2.1.0

# Analysis configuration
sonar.sources=src
sonar.tests=src
sonar.sourceEncoding=UTF-8

# Coverage settings
sonar.javascript.lcov.reportPaths=src/patient-service/coverage/lcov.info,src/appointment-service/coverage/lcov.info
sonar.coverage.exclusions=**/node_modules/**,**/*.test.js

# Exclude non-source files from both main and test analysis
sonar.exclusions=**/Dockerfile,**/node_modules/**,**/coverage/**,**/*.yaml,**/*.yml,**/*.json,**/*.md,**/*.lock,terraform/**,kubernetes/**
sonar.test.exclusions=**/Dockerfile,**/node_modules/**,**/coverage/**,**/*.yaml,**/*.yml,**/*.json,**/*.md,**/*.lock,terraform/**,kubernetes/**

# Quality Gate
sonar.qualitygate.wait=true

# Disable automatic analysis
sonar.analysis.automatic=false