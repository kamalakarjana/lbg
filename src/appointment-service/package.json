{
  "name": "appointment-service",
  "version": "1.0.0",
  "description": "Appointment Service for Healthcare App",
  "main": "appointment-service.js",
  "scripts": {
    "start": "node appointment-service.js",
    "dev": "nodemon appointment-service.js",
    "test": "jest --coverage --watchAll=false",
    "lint": "eslint .",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "mongoose": "^8.0.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "eslint": "^8.57.0",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "coverageDirectory": "coverage"
  }
}