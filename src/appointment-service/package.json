{
  "name": "appointment-service",
  "version": "1.2.0-dev",
  "description": "Appointment Service for Healthcare App - Manages appointment scheduling and management - Development Version",
  "main": "appointment-service.js",
  "scripts": {
    "start": "node appointment-service.js",
    "dev": "nodemon appointment-service.js",
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:dev": "jest --coverage --verbose --watchAll",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security:audit": "npm audit",
    "build": "echo 'No build step required for Node.js'",
    "docker:build": "docker build -t kamalj2kkkk.azurecr.io/appointment-service:dev .",
    "docker:push": "docker push kamalj2kkkk.azurecr.io/appointment-service:dev"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "healthcare",
