{
  "name": "patient-service",
  "version": "1.0.0",
  "description": "Patient Service for Healthcare App",
  "main": "patient-service.js",
  "scripts": {
    "start": "node patient-service.js",
    "dev": "nodemon patient-service.js",
    "test": "jest --watchAll=false --coverage --passWithNoTests --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "4.18.2",
    "cors": "2.8.5",
    "helmet": "7.1.0",
    "mongoose": "8.0.3"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "6.3.4",
    "eslint": "8.57.0",
    "nodemon": "3.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "forceExit": true,
    "detectOpenHandles": true
  }
}