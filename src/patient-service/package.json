{
  "name": "patient-service",
  "version": "2.1.0-dev",
  "description": "Patient Service for Healthcare App - Manages patient data and records - Development Version",
  "main": "patient-service.js",
  "scripts": {
    "start": "node patient-service.js",
    "dev": "nodemon patient-service.js",
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:dev": "jest --coverage --verbose --watchAll",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security:audit": "npm audit",
    "build": "echo 'No build step required for Node.js'",
    "docker:build": "docker build -t kamalj2kkkk.azurecr.io/patient-service:dev .",
    "docker:push": "docker push kamalj2kkkk.azurecr.io/patient-service:dev"
